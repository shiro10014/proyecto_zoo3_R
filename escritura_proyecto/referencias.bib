@article{martinez-urbinaAnalisisNichoEcologico2022,
  title = {Análisis de nicho ecológico de Amazona auropalliata (Psittaciformes: Psittacidae) y Quiscalus mexicanus (Passeriformes: Icteridae) en Costa Rica},
  shorttitle = {Análisis de nicho ecológico de Amazona auropalliata (Psittaciformes},
  author = {Martínez-Urbina, Jamie},
  date = {2022-12-15},
  journaltitle = {Biocenosis},
  shortjournal = {RB},
  volume = {33},
  number = {2},
  pages = {7--15},
  issn = {1659-4991},
  doi = {10.22458/rb.v33i2.4537},
  url = {https://revistas.uned.ac.cr/index.php/biocenosis/article/view/4537},
  urldate = {2026-09-26},
  abstract = {Se analizaron bases de datos de observaciones humanas de las especies Amazona auropalliata (amazona nuca amarilla) y Quiscalus mexicanus (zanate) en el territorio costarricense, como área de interés, así se conoció el patrón de distribución geográfica y su influencia en el solapamiento de nicho de ambas especies. Se usaron 20 variables bioclimáticas y, mediante el programa RStudio, se conocieron las correlaciones principales entre todas las variables para cada una de las especies del estudio. La especie invasora Quiscalus mexicanus muestra una amplia expansión de distribución geográfica ya que puede adaptarse a zonas de gran perturbación ambiental ocasionada por los seres humanos, tal como la urbanización o las actividades agrícolas, además tolera los cambios climáticos, mientras que la Amazona auropalliata tiene una distribución restringida de acuerdo con su alimentación y anidación. Por tanto, se puede intuir que la especie invasora podría influir en la disminución de las poblaciones de Amazona auropalliata, la cual es encuentra en peligro de extinción de acuerdo con la IUCN (2020).},
  langid = {spanish},
  file = {/home/npulecio/Zotero/storage/58NJDVES/Martínez-Urbina - 2022 - Análisis de nicho ecológico de Amazona auropalliata (Psittaciformes Psittacidae) y Quiscalus mexica.pdf}
}

