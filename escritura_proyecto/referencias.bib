@article{zunigaCRECIMIENTOMANCHAURBANA,
  title = {CRECIMIENTO DE LA MANCHA URBANA DE BARRANQUILLA Y SU ÁREA METROPOLITANA (2004–2025): TRANSFORMACIONES TERRITORIALES, RETOS Y PERSPECTIVAS DE PLANIFICACIÓN},
  author = {Zúñiga, Erlin Milanés and Godoy, Rubén Darío},
  abstract = {Barranquilla and its metropolitan area experienced rapid urban growth between 2004 and 2025, characterized by urban sprawl, the consolidation of new development corridors, and the construction of significant infrastructure projects. This research critically analyzes the factors that drove this transformation, including population growth, investment in social housing, the expansion of road networks, and the revitalization of public spaces. It also examines the sociospatial implications of this growth, such as residential segregation, informality, and environmental sustainability challenges. Finally, it presents proposed guidelines for future territorial planning, aimed at strengthening social cohesion, urban resilience, and the protection of strategic ecosystems.},
  langid = {spanish},
  file = {/home/npulecio/Zotero/storage/23E83PRI/Zúñiga y Godoy - CRECIMIENTO DE LA MANCHA URBANA DE BARRANQUILLA Y SU ÁREA METROPOLITANA (2004–2025) TRANSFORMACIONE.pdf}
}
